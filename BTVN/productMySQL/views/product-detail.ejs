<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= product.name %> - Hỷ Lâm Môn</title>
    <link rel="stylesheet" href="/css/style.css">
  </head>
  <body>
    <%- include('partials/header') %>
    <main class="container page-content">
      <div class="breadcrumb"><a href="/">Trang chủ</a> / <a href="/product">Sản phẩm</a> / <span><%= product.name %></span></div>
      <section class="detail-card">
        <div class="detail-image">
          <img src="/images/products/<%= encodeURIComponent(product.image) %>" alt="<%= product.name %>">
        </div>
        <div class="detail-content">
          <p class="eyebrow"><%= product.category %></p>
          <h1><%= product.name %></h1>
          <div class="detail-price">
            <% if (product.promotionPrice < product.unitPrice) { %>
              <span class="old-price"><%= formatPrice(product.unitPrice) %> ₫</span>
            <% } %>
            <strong><%= formatPrice(product.promotionPrice < product.unitPrice ? product.promotionPrice : product.unitPrice) %> ₫</strong>
          </div>
          <p class="detail-description"><%= product.description %></p>
          <p class="detail-unit">Đơn vị: <strong><%= product.unit %></strong></p>
          <a class="primary-button" href="/product">← Quay lại sản phẩm</a>
        </div>
      </section>

      <% if (relatedProducts.length) { %>
        <section class="product-section related-section">
          <div class="section-heading"><h2>Sản phẩm liên quan</h2></div>
          <div class="product-grid">
            <% relatedProducts.forEach(product => { %>
              <%- include('partials/product-card', { product }) %>
            <% }) %>
          </div>
        </section>
      <% } %>
    </main>
    <%- include('partials/footer') %>
  </body>
</html>

