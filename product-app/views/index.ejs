<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <title>Quản lý sản phẩm</title>
</head>
<body class="bg-light">
  <main class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
      <h1 class="m-0">Danh sách sản phẩm</h1>
      <a class="btn btn-success" href="/add">+ Thêm sản phẩm</a>
    </div>

    <form action="/search" method="GET" class="input-group mb-4">
      <input class="form-control" name="q" value="<%= query || '' %>" placeholder="Tìm theo tên sản phẩm">
      <button class="btn btn-primary" type="submit">Tìm kiếm</button>
      <% if (query) { %><a class="btn btn-outline-secondary" href="/">Xóa tìm kiếm</a><% } %>
    </form>

    <% if (!products.length) { %>
      <div class="alert alert-info">Không tìm thấy sản phẩm nào.</div>
    <% } else { %>
      <div class="row g-4">
        <% products.forEach(product => { %>
          <div class="col-sm-6 col-lg-4 col-xl-3">
            <article class="card h-100 shadow-sm">
              <img src="<%= product.image %>" class="card-img-top" alt="<%= product.name %>" style="height: 220px; object-fit: cover;">
              <div class="card-body d-flex flex-column">
                <h2 class="h5 card-title"><%= product.name %></h2>
                <p class="card-text mb-1">Giá: <strong><%= product.price.toLocaleString('vi-VN') %> đ</strong></p>
                <p class="card-text">Còn lại: <%= product.quantity %></p>
                <div class="mt-auto d-flex flex-wrap gap-2">
                  <a href="/products/<%= product._id %>" class="btn btn-info btn-sm">Chi tiết</a>
                  <a href="/edit/<%= product._id %>" class="btn btn-warning btn-sm">Sửa</a>
                  <form action="/delete/<%= product._id %>" method="POST" onsubmit="return confirm('Xóa sản phẩm này?')">
                    <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                  </form>
                </div>
              </div>
            </article>
          </div>
        <% }); %>
      </div>
    <% } %>
  </main>
</body>
</html>
