<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <title><%= product.name %></title>
</head>
<body class="bg-light">
  <main class="container py-4" style="max-width: 900px">
    <a href="/" class="btn btn-outline-secondary mb-4">← Danh sách</a>
    <article class="card shadow-sm overflow-hidden">
      <div class="row g-0">
        <div class="col-md-6">
          <img src="<%= product.image %>" alt="<%= product.name %>" class="w-100 h-100" style="min-height: 360px; object-fit: cover;">
        </div>
        <div class="col-md-6">
          <div class="card-body p-4">
            <h1 class="card-title"><%= product.name %></h1>
            <p class="fs-4 text-primary"><%= product.price.toLocaleString('vi-VN') %> đ</p>
            <p>Số lượng còn lại: <strong><%= product.quantity %></strong></p>
            <a href="/edit/<%= product._id %>" class="btn btn-warning">Sửa sản phẩm</a>
          </div>
        </div>
      </div>
    </article>
  </main>
</body>
</html>
