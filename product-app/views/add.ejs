<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <title>Thêm sản phẩm</title>
</head>
<body class="bg-light">
  <main class="container py-4" style="max-width: 720px">
    <h1 class="mb-4">Thêm sản phẩm</h1>
    <form action="/add" method="POST" enctype="multipart/form-data" class="card card-body shadow-sm">
      <label class="form-label" for="name">Tên sản phẩm</label>
      <input class="form-control mb-3" id="name" name="name" required maxlength="120">

      <label class="form-label" for="price">Giá</label>
      <input class="form-control mb-3" id="price" name="price" type="number" min="0" step="0.01" required>

      <label class="form-label" for="quantity">Số lượng</label>
      <input class="form-control mb-3" id="quantity" name="quantity" type="number" min="0" step="1" required>

      <label class="form-label" for="image">Hình ảnh</label>
      <input class="form-control mb-4" id="image" name="image" type="file" accept="image/jpeg,image/png,image/gif,image/webp" required>

      <div>
        <button class="btn btn-success" type="submit">Lưu sản phẩm</button>
        <a class="btn btn-secondary" href="/">Quay lại</a>
      </div>
    </form>
  </main>
</body>
</html>
