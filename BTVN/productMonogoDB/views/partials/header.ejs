<header class="site-header">
  <nav class="main-nav" aria-label="Điều hướng chính">
    <div class="container nav-inner">
      <a class="brand" href="/">Hỷ Lâm Môn</a>
      <div class="nav-links">
        <a class="<%= currentPath === '/' ? 'active' : '' %>" href="/">Trang chủ</a>
        <a class="<%= currentPath === '/product' || currentPath.startsWith('/product/') ? 'active' : '' %>" href="/product">Sản phẩm</a>
        <a class="<%= currentPath === '/about' ? 'active' : '' %>" href="/about">Giới thiệu</a>
        <a class="<%= currentPath === '/contact' ? 'active' : '' %>" href="/contact">Liên hệ</a>
      </div>
      <form class="search-form" action="/product" method="get">
        <label class="sr-only" for="search">Tìm sản phẩm</label>
        <input id="search" name="q" type="search" placeholder="Tìm bánh...">
        <button type="submit" aria-label="Tìm kiếm">⌕</button>
      </form>
    </div>
  </nav>
</header>
