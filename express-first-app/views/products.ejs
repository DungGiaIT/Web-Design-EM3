<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Danh sách sản phẩm</title>
</head>
<body>
  <h1>Danh sách sản phẩm</h1>
  <ul>
    <% products.forEach(p => { %>
      <li><%= p.id %> - <%= p.name %> - $<%= p.price %></li>
    <% }) %>
  </ul>
</body>
</html>